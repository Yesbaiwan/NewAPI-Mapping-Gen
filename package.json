{
  "name": "newapi-mapping-generator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit && prettier --check \"index.html\" \"src/**/*.{ts,vue,css}\" \"worker/**/*.ts\"",
    "format": "prettier --write \"index.html\" \"src/**/*.{ts,vue,css}\" \"worker/**/*.ts\""
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
